# Image ramping dari hasil build host: `.next/standalone` sudah memuat
# server.js + node_modules produksi. Konteks build = folder berisi `app/`.
# (Dipakai bila npm di dalam container tidak tersedia; lihat deploy di README.)
FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 PORT=3000 HOSTNAME=0.0.0.0
RUN addgroup -S nodejs && adduser -S nextjs -G nodejs
COPY app ./
USER nextjs
EXPOSE 3000
CMD ["node", "server.js"]
